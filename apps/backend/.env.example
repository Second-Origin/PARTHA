APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
DATABASE_URL=sqlite:///./.local/partha.db
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./.local/storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=true
# Required outside development/test. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
